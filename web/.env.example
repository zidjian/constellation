# Web de Constellation. Copia este archivo a .env.local.

# URL pública de la API, la que usa el navegador. Se incrusta en BUILD TIME (NEXT_PUBLIC_*):
# el build de producción tiene que hacerse ya con la URL real.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opcional. URL que usa el servidor de Next (Server Components y proxy.ts) para llamar a la API.
# En local no hace falta: sin ella se usa NEXT_PUBLIC_API_URL. En producción sirve para ir por
# localhost y no dar la vuelta por internet, p. ej. http://127.0.0.1:3011
API_INTERNAL_URL=
