# API de Constellation. Copia este archivo a .env y completa lo tuyo.
# El arranque valida todo con Zod (src/shared/infrastructure/config/env.ts) y falla listando
# cada variable inválida, así que un valor mal puesto se ve al instante.

# ── Básico ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://constellation:constellation@localhost:5432/constellation
# Origen exacto de la web: el CORS con credenciales no admite '*'.
WEB_ORIGIN=http://localhost:3000
# Vacío en local (la cookie queda host-only). En producción: .constellation.waldirmaidana.com
COOKIE_DOMAIN=

# ── Sesión y Discord ─────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Genera el tuyo: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-openssl-rand-hex-32-xxxxxxxxxxxxxxxx
# Una app del Developer Portal de Discord, con esta redirect URI registrada tal cual.
# Las tres son obligatorias: sin ellas la API no arranca. El login con correo no las usa.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/v1/auth/discord/callback

# ── Correo: alta y recuperación de contraseña ────────────────────────────────
# Sin clave, el enlace se escribe en el log de la API y el flujo se prueba igual.
RESEND_API_KEY=
# onboarding@resend.dev solo entrega a la cuenta dueña de la clave. En producción, dominio propio.
MAIL_FROM=Constellation <onboarding@resend.dev>

# ── Generación de rutas ──────────────────────────────────────────────────────
# Pausa entre eventos del stream para que la constelación se dibuje paso a paso (0–2000 ms).
PATH_STREAM_DELAY_MS=150

# ── IA (ADR-0001) ────────────────────────────────────────────────────────────
# 'rules' = ninguna llamada externa. 'claude' = Claude, con vuelta a reglas ante error o timeout.
# Con 'claude', ANTHROPIC_API_KEY es obligatoria o la API no arranca.
LLM_PROVIDER=rules
ANTHROPIC_API_KEY=
# Interpreta la entrevista y redacta el porqué de cada paso.
ANTHROPIC_MODEL=claude-opus-5

# Simulacro de entrevista con reclutador. Requiere LLM_PROVIDER=claude.
RECRUITER_ENABLED=false
# Conduce la charla; el informe final lo redacta ANTHROPIC_MODEL.
ANTHROPIC_INTERVIEW_MODEL=claude-sonnet-5

# Topes en milisegundos. Al agotarse, responde el adaptador por reglas.
# Bloquea la respuesta de completar la entrevista: tope corto.
LLM_TIMEOUT_MS=8000
# El porqué se redacta mientras se emiten los pasos: más margen.
LLM_RATIONALE_TIMEOUT_MS=25000
# Un turno del simulacro, en vivo.
LLM_RECRUITER_TIMEOUT_MS=20000
# El informe final del simulacro es largo: el tope más alto.
LLM_REPORT_TIMEOUT_MS=60000
